# Copy this file to .env and fill in real keys.
# stock_market/views.py and stock_market/misc.py load these via python-dotenv.

# Stock quotes. NOTE: IEX Cloud was fully retired on Aug 31, 2024, so this
# key will not return live data until the code is pointed at another
# provider (e.g. Alpha Vantage, Financial Modeling Prep, Polygon.io).
IEX_API_KEY=your_iex_api_key_here

# https://newsapi.org — the free "Developer" plan is for local/dev use only.
NEWS_API_KEY=your_newsapi_key_here
